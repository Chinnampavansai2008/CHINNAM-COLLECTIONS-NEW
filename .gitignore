# ==========================================
# CHINNAM COLLECTIONS - .gitignore
# ==========================================

# Operating System & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Shopify CLI & Local Store Configurations
.shopify
.shopify/
*.shopify
shopify.theme.toml
theme.config.json

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.secret

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Theme Archives & Builds
*.zip
*.tar.gz
dist/
build/

# Editor & IDE Directories
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Cache & Temporary Files
.cache/
.sass-cache/
tmp/
temp/
*.tmp
